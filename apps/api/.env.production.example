# ==========================================
# OJALOGS API - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

PORT=4000
NODE_ENV=production

# Allowed CORS Origins (comma-separated for multi-domain)
CORS_ORIGIN=https://ojalogs.com,https://www.ojalogs.com,https://app.ojalogs.com

# 32-Byte Hex AES-256-GCM Master Key for Vault Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Supabase Production PostgreSQL Database Credentials
SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# BACH Payment Gateway (Production Credentials from bachs.io)
# Sandbox Base URL: https://sandbox-api.bachs.io/v1
# Production Base URL: https://api.bachs.io/v1
BACHS_BASE_URL=https://api.bachs.io/v1
BACHS_API_KEY=sk_live_...
BACHS_WEBHOOK_SECRET=whsec_live_...

# Upstream Server APIs (Tier 1 to 4)
SERVER_1_API_KEY=srv1_live_...
SERVER_1_API_URL=https://api.tier1-provider.com/v1

SERVER_2_API_KEY=srv2_live_...
SERVER_2_API_URL=https://api.tier2-provider.com/v1

SERVER_3_API_KEY=srv3_live_...
SERVER_3_API_URL=https://api.tier3-provider.com/v1

SERVER_4_API_KEY=srv4_live_...
SERVER_4_API_URL=https://api.tier4-provider.com/v1

# Telephony SMS Gateway API
TELEPHONY_GATEWAY_API_KEY=tel_live_...
TELEPHONY_GATEWAY_URL=https://api.telephony-provider.com/v1

