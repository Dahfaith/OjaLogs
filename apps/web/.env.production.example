# ==========================================
# OJALOGS WEB - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# Public URL of the deployed backend API (Express / Serverless)
# e.g., https://api.ojalogs.com/api/v1 or https://ojalogs-api.railway.app/api/v1
VITE_API_URL=https://api.ojalogs.com/api/v1

# Supabase Public Anonymous Configuration
VITE_SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Default Currency
VITE_DEFAULT_CURRENCY=NGN

